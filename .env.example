# Event forms (/admin). Copy to .env.local for local testing, and add the same keys on the host.
ADMIN_PASSWORD=choose-a-long-password
# Optional: changes the login cookie signature (logs everyone out when changed)
ADMIN_SECRET=

# Supabase database (Project settings → API). Without these, responses are saved to .data/ (local testing only).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Resend email (resend.com → API keys). Without a key, the Excel file is saved to .data/outbox/.
RESEND_API_KEY=
FORMS_NOTIFY_EMAIL=sunitaexportsindia@gmail.com
# Needs a verified domain on Resend; until then leave empty to use Resend's test sender.
FORMS_FROM_EMAIL=
